    "scripts/apps/HomeApp.js",
    "scripts/apps/MessagesApp.js",
    "scripts/apps/ContactsApp.js",
    "scripts/apps/PhoneApp.js",
    "scripts/apps/SettingsApp.js",
    "scripts/apps/CalculatorApp.js",
    "scripts/apps/NotesApp.js",
    "scripts/apps/SocialApp.js",
    "scripts/apps/MinefinderApp.js",
    "scripts/apps/CheckersApp.js",
    "scripts/apps/BankingApp.js",
