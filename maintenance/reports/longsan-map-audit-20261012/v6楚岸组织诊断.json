  "diagnosis": [
    {
      "cause": "连通性指标只证明不同线能到达，未约束道路等级接续",
      "effect": "城市干道在普通支路上圆头终止，骨干方向与大块交叉关系没有先规划；主街可能以几米宽小路完成连通"
    },
    {
      "cause": "旧骨干和新旋转BSP街道两套方向叠加；每face递归切路后端点就近挂接",
      "effect": "多方向是局部切割副产物，形成大量短T路和尽端，不是有主街、次街与巷道的统一街坊组织"
    },
    {
      "cause": "临街分的是lot，建筑独立缩放后位于pad内部，未将临街立面锚定公共路或街墙线",
      "effect": "统计frontage很短但实体屋顶离路几十至百余米；形成撒点，城市中心也缺连续街墙"
    },
    {
      "cause": "每lot随机用途、形状和占据率，邻接lot缺同一开发项目/年代/沿街商业段的约束",
      "effect": "单块住宅、院落、办公和泛学研建筑轮番出现；独立院落无法替代成片租界街坊或住宅小区"
    },
    {
      "cause": "未建lot直接作shared-garden；继承的绿地/田块处理独立于最终街坊院落组织",
      "effect": "矩形草地和巨型空块成为填充纹理，缺道路入口、路径、公共空间等级和明确用途"
    }
  ],
  "next_geometry_rules": [
    "先画楚岸主要滨江/租界/南段混居三片道路骨架，固定每片主轴和交接节点，保留河道/既有POI/地铁锚点",
    "为每片确定80–180m等可审阅街坊尺度；工业或大型场地例外必须有功能说明；大于上限的街坊先补贯通道路",
    "主次干道端点接同级或更高道路；局部支路才能尽端，尽端必须服务真实小区或场地",
    "按沿街地块连续分面宽/进深，贴道路退界放立面；租界街墙共用一条退界线，而不是在lot中心随机撒单栋",
    "把完整开发单元作为生成单位：街墙+内院、住宅组团+内部路、工业场地+装卸院，各自决定楼群排列",
    "绿地以明确公园/街坊院落/空置重建地块生成，不把未占据lot统一涂绿",
    "分开验收骨干等级、街坊面积、街墙连续、实际屋顶退界、院落入口；全图连通与无碰撞仅是必要条件"
  ],
  "verification_boundary": "截取、交点和距离来自v6实际SVG/GeoJSON；美术因果是代码结构与图面共同支持的诊断。没有对真实城市合法或工程指标作定量承诺。"
