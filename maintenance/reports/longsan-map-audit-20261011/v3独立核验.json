    {
      "topic": "楚岸、西岸地标",
      "adopted": "楚岸核心、楚风传媒、引资银行在楚江西岸；采用用户明确裁决。",
      "basis": "user"
    },
    {
      "topic": "水系与站距",
      "adopted": "原图只供站序、换乘及粗略岸别；岸线、岛形与公里站位为新设计。",
      "basis": "user"
    },
    {
      "topic": "深中相关设施",
      "adopted": "财经大学、沙尾、奥体中心、枫湾、楚江西路和燧明园均采用设定稿的岛上归属，产生相应跨江区间。",
      "basis": "setting; diagram conflicts recorded"
    },
    {
      "topic": "北岭跨江",
      "adopted": "湖区、云鲤路等西岸站群保留原图岸别，东岸天街、长乐街和北岭站形成对岸片区；不绘未统一的正式区界。",
      "basis": "diagram; district text differs"
    },
    {
      "topic": "楚江广场与醒钟",
      "adopted": "保留原图东岸桥头位置；楚江广场属于跨江桥头，醒钟的文星区归属仍待统一。",
      "basis": "diagram; district text differs"
    },
    {
      "topic": "骑楼街、海关旧址、江湾",
      "adopted": "骑楼街与海关保留原图西岸，海关在江湾以北；江湾保留岛上位置。区名与部分站表冲突在此保留，不擅改原稿。",
      "basis": "diagram"
    },
    {
      "topic": "旧城区和故城区",
      "adopted": "分别标示；旧城区塌陷区域位于铁铺以南、龙门吊路东北、船政学堂以东。主体阶段不画塌陷边界。",
      "basis": "user"
    },
    {
      "topic": "街坊和场地",
      "adopted": "功能决定街坊与建筑占地；平地采用稳定正交网格，曲线用于地形、滨江和既有主路转弯。",
      "basis": "user; reference atlas"
    },
    {
      "topic": "停用站和塌陷区域",
      "adopted": "继承三个站的停用状态；故城中心停用站与塌陷区域的因果关系留待源设定统一。撤销 v2 的灰区面积、边界和隔离墙解释。",
      "basis": "user"
    },
    {
      "topic": "面积与园区道路",
      "adopted": "大学完整地块 500 亩，科技园完整地块 300 亩。科技园同面积地块向南平移 70 m，深中大道从西侧、南侧绕行；不以道路扣除前面积冒充可用地块面积。塌陷区面积未定。",
      "basis": "setting + current design"
    },
    {
      "topic": "v2 模型沿用范围",
      "adopted": "水系、江心洲、站点、线路区间保持原公里几何；重建城市建筑与公共空间，恢复原误置灰区内的街道。学府大道从校园东边绕行；传媒与银行落在西岸邻近完整地块。",
      "basis": "user"
    }
  ],
